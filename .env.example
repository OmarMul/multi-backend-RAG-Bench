# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Framework & Backend Switches
RAG_FRAMEWORK=langchain       # Options: langchain | llamaindex
VECTOR_BACKEND=chroma         # Options: chroma | qdrant

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=openai/gpt-5.6-luna # Options: anthropic/claude-haiku-4.5:batch | google/gemini-3.8-flash

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small

# Ingestion / Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Vector Stores
CHROMA_PERSIST_DIR=./data/chroma_db
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=rag_bench_docs

# Redis & Postgres
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_bench


# Tracing / Observability (Optional - Leave blank to use built-in local logger)
ENABLE_TRACING=true
# LangSmith Configuration
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=rag-bench
# Langfuse Configuration
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com